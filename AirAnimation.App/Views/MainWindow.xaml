<Window x:Class="AirAnimation.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AirAnimation.App.ViewModels"
        xmlns:views="clr-namespace:AirAnimation.App.Views"
        mc:Ignorable="d"
        Title="{Binding AppTitle}"
        Height="820" Width="1440"
        MinHeight="680" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDeepBrush}"
        AllowsTransparency="False">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>   <!-- Title bar -->
            <RowDefinition Height="*"/>    <!-- Content -->
            <RowDefinition Height="44"/>   <!-- Timeline bar -->
            <RowDefinition Height="24"/>   <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ── TITLE BAR ──────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderBrush_}"
                BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="✈" FontSize="22" Margin="0,0,8,0"
                               Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="AirAnimation"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Main menu -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="24,0,0,0"
                            VerticalAlignment="Center">
                    <Button Content="Новый"    Style="{StaticResource GhostBtn}" Command="{Binding NewProjectCommand}"    Margin="2,0"/>
                    <Button Content="Открыть"  Style="{StaticResource GhostBtn}" Command="{Binding OpenProjectCommand}"   Margin="2,0"/>
                    <Button Content="Сохранить" Style="{StaticResource GhostBtn}" Command="{Binding SaveProjectCommand}"  Margin="2,0"/>
                    <Button Content="Сохранить как..." Style="{StaticResource GhostBtn}" Command="{Binding SaveAsProjectCommand}" Margin="2,0"/>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"
                               Background="{StaticResource BorderBrush_}" Width="1" Margin="8,8"/>
                    <Button Content="📥 GPX"   Style="{StaticResource GhostBtn}" Command="{Binding ImportGpxCommand}"    Margin="2,0"/>
                </StackPanel>

                <!-- Busy indicator -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="0,0,6,0">
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0.2" Duration="0:0:0.6"
                                                         AutoReverse="True"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <TextBlock Text="Загрузка..." FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── MAIN CONTENT ───────────────────────────────────────── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="240" MaxWidth="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL -->
            <Border Grid.Column="0"
                    Background="{StaticResource SidebarGradient}"
                    BorderBrush="{StaticResource BorderBrush_}"
                    BorderThickness="0,0,1,0">
                <TabControl Background="Transparent"
                            BorderThickness="0"
                            Padding="0">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border x:Name="brd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter ContentSource="Header"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="brd" Property="Background" Value="#22FFFFFF"/>
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="brd" Property="Background" Value="#11FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style TargetType="TabPanel">
                            <Setter Property="Background" Value="{StaticResource BgPanelBrush}"/>
                        </Style>
                    </TabControl.Resources>

                    <TabItem Header="📍 Маршрут">
                        <views:RouteEditorView DataContext="{Binding RouteViewModel}"
                                               x:Name="RouteEditor"/>
                    </TabItem>
                    <TabItem Header="🚗 Транспорт">
                        <views:TransportPickerView DataContext="{Binding TransportViewModel}"/>
                    </TabItem>
                    <TabItem Header="🎬 Анимация">
                        <views:AnimationSettingsView DataContext="{Binding AnimationViewModel}"/>
                    </TabItem>
                    <TabItem Header="📹 Экспорт">
                        <views:ExportView DataContext="{Binding ExportViewModel}"/>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- MAP -->
            <views:MapView Grid.Column="1"
                           x:Name="MapViewControl"
                           DataContext="{Binding MapViewModel}"/>
        </Grid>

        <!-- ── TIMELINE / PLAYBACK BAR ────────────────────────────── -->
        <Border Grid.Row="2"
                Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderBrush_}"
                BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Play controls -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="⏹" Style="{StaticResource GhostBtn}" FontSize="16"
                            Command="{Binding StopAnimationCommand}" ToolTip="Стоп" Padding="8,4"/>
                    <Button x:Name="BtnPlay" Content="▶" Style="{StaticResource PrimaryBtn}" FontSize="14"
                            Command="{Binding PlayAnimationCommand}" ToolTip="Воспроизвести"
                            Padding="14,6" Margin="4,0"
                            Visibility="{Binding AnimationViewModel.IsPlaying, Converter={StaticResource InvBoolToVis}}"/>
                    <Button Content="⏸" Style="{StaticResource GhostBtn}" FontSize="16"
                            Command="{Binding PauseAnimationCommand}" ToolTip="Пауза" Padding="8,4"
                            Visibility="{Binding AnimationViewModel.IsPlaying, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>

                <!-- Progress slider -->
                <Slider Grid.Column="1"
                        Margin="16,0"
                        Minimum="0" Maximum="1"
                        Value="{Binding AnimationViewModel.Progress, Mode=TwoWay}"
                        VerticalAlignment="Center"/>

                <!-- Distance info -->
                <TextBlock Grid.Column="2"
                           Text="{Binding AnimationViewModel.DistanceLabel}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12" VerticalAlignment="Center"
                           Margin="0,0,16,0"/>

                <!-- Export button -->
                <Button Grid.Column="3"
                        Content="📹 Экспорт MP4"
                        Style="{StaticResource SuccessBtn}"
                        Command="{Binding ExportViewModel.ExportVideoCommand}"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ── STATUS BAR ─────────────────────────────────────────── -->
        <Border Grid.Row="3"
                Background="{StaticResource BgDeepBrush}"
                BorderBrush="{StaticResource BorderBrush_}"
                BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="AirAnimation · .NET 10 · MapLibre GL JS 5"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
