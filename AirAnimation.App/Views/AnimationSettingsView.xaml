<UserControl x:Class="AirAnimation.App.Views.AnimationSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer>
        <StackPanel Margin="14,10">
            <TextBlock Text="НАСТРОЙКИ АНИМАЦИИ" Style="{StaticResource SectionHeader}"/>

            <!-- Speed & Duration Card -->
            <Border Style="{StaticResource Card}" Margin="0,4,0,12">
                <StackPanel>
                    <TextBlock Text="⏱ Время и скорость анимации" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>

                    <RadioButton Content="Задать множитель скорости"
                                 IsChecked="{Binding UseTargetDuration, Converter={StaticResource InverseBoolConverter}}"
                                 GroupName="DurationMode" Margin="0,0,0,4"/>
                                 
                    <StackPanel IsEnabled="{Binding UseTargetDuration, Converter={StaticResource InverseBoolConverter}}" Margin="16,0,0,12">
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="{Binding SpeedLabel}" HorizontalAlignment="Right"
                                       Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="14"/>
                        </Grid>
                        
                        <Slider Minimum="0.5" Maximum="500"
                                Value="{Binding SpeedMultiplier, Mode=TwoWay}"
                                IsMoveToPointEnabled="True"
                                SmallChange="1" LargeChange="25"
                                Margin="0,0,0,10"/>

                        <TextBlock Text="Быстрый выбор скорости:" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <WrapPanel HorizontalAlignment="Center">
                            <Button Content="1×"   Style="{StaticResource GhostBtn}" FontSize="10" Padding="6,3" Margin="2" Tag="1"   Click="SpeedPreset_Click"/>
                            <Button Content="5×"   Style="{StaticResource GhostBtn}" FontSize="10" Padding="6,3" Margin="2" Tag="5"   Click="SpeedPreset_Click"/>
                            <Button Content="10×"  Style="{StaticResource GhostBtn}" FontSize="10" Padding="6,3" Margin="2" Tag="10"  Click="SpeedPreset_Click"/>
                            <Button Content="25×"  Style="{StaticResource GhostBtn}" FontSize="10" Padding="6,3" Margin="2" Tag="25"  Click="SpeedPreset_Click"/>
                            <Button Content="50×"  Style="{StaticResource GhostBtn}" FontSize="10" Padding="6,3" Margin="2" Tag="50"  Click="SpeedPreset_Click"/>
                            <Button Content="100×" Style="{StaticResource GhostBtn}" FontSize="10" Padding="6,3" Margin="2" Tag="100" Click="SpeedPreset_Click"/>
                        </WrapPanel>
                    </StackPanel>

                    <RadioButton Content="Задать точное время видео"
                                 IsChecked="{Binding UseTargetDuration}"
                                 GroupName="DurationMode" Margin="0,0,0,4"/>
                                 
                    <StackPanel IsEnabled="{Binding UseTargetDuration}" Margin="16,0,0,4">
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Длительность (секунд):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="14">
                                <Run Text="{Binding TargetDurationSeconds, StringFormat={}{0:F0} сек, Mode=OneWay}"/>
                            </TextBlock>
                        </Grid>
                        
                        <Slider Minimum="5" Maximum="60"
                                Value="{Binding TargetDurationSeconds, Mode=TwoWay}"
                                IsMoveToPointEnabled="True"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                Margin="0,0,0,4"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Flight Orientation & 3D Physics (New requested options) -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="🧭 Ориентация самолёта и физика 3D" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                    
                    <TextBlock Text="Положение относительно курса:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <UniformGrid Columns="3" Margin="0,0,0,10">
                        <Button Content="✈ Носом вперёд" Style="{StaticResource GhostBtn}" FontSize="9" Padding="4,5" Margin="2" Tag="forward" Click="OrientationMode_Click"/>
                        <Button Content="📐 Ракурс 3/4" Style="{StaticResource GhostBtn}" FontSize="9" Padding="4,5" Margin="2" Tag="isometric" Click="OrientationMode_Click"/>
                        <Button Content="↔ Сбоку 90°" Style="{StaticResource GhostBtn}" FontSize="9" Padding="4,5" Margin="2" Tag="side" Click="OrientationMode_Click"/>
                    </UniformGrid>

                    <!-- Model Angle Offset Slider -->
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="Угол смещения модели:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="11">
                            <Run Text="{Binding ModelAngleOffset, StringFormat={}{0:F0}°, Mode=OneWay}"/>
                        </TextBlock>
                    </Grid>
                    <Slider Minimum="-180" Maximum="180"
                            Value="{Binding ModelAngleOffset, Mode=TwoWay}"
                            IsMoveToPointEnabled="True"
                            SmallChange="5" LargeChange="15" Margin="0,0,0,10"/>

                    <!-- Altitude Slider -->
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="Высота полёта 3D (элевация):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="11">
                            <Run Text="{Binding FlightAltitude, StringFormat={}{0:F0} м, Mode=OneWay}"/>
                        </TextBlock>
                    </Grid>
                    <Slider Minimum="300" Maximum="10000"
                            Value="{Binding FlightAltitude, Mode=TwoWay}"
                            IsMoveToPointEnabled="True"
                            SmallChange="200" LargeChange="1000" Margin="0,0,0,10"/>

                    <CheckBox Content="Динамический крен при виражах (3D Banking)"
                              IsChecked="{Binding EnableBanking, Mode=TwoWay}"
                              Margin="0,0,0,8"/>
                              
                    <CheckBox Content="Сглаживание движений (кинематографичная камера)"
                              IsChecked="{Binding SmoothAnimation, Mode=TwoWay}"/>
                </StackPanel>
            </Border>

            <!-- Route Drawing Mode (TravelBoast Trailing vs Full Route) -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="🛤 Построение маршрута" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                    
                    <TextBlock Text="Режим отрисовки:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <UniformGrid Columns="2" Margin="0,0,0,10">
                        <Button Content="✈ След позади (TravelBoast)" Style="{StaticResource GhostBtn}" FontSize="10" Padding="6,6" Margin="2" Tag="trailOnly" Click="RouteDrawMode_Click"/>
                        <Button Content="🗺 Полный маршрут" Style="{StaticResource GhostBtn}" FontSize="10" Padding="6,6" Margin="2" Tag="fullRoute" Click="RouteDrawMode_Click"/>
                    </UniformGrid>

                    <TextBlock Text="Стиль линии следа:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <UniformGrid Columns="3" Margin="0,0,0,4">
                        <Button Content="🔴 Красный пунктир" Style="{StaticResource GhostBtn}" FontSize="9" Padding="4,4" Margin="2" Tag="redDashed" Click="TrailStyle_Click"/>
                        <Button Content="⚪ Белый пунктир" Style="{StaticResource GhostBtn}" FontSize="9" Padding="4,4" Margin="2" Tag="whiteDashed" Click="TrailStyle_Click"/>
                        <Button Content="⚡ Неоновый след" Style="{StaticResource GhostBtn}" FontSize="9" Padding="4,4" Margin="2" Tag="neon" Click="TrailStyle_Click"/>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- 3D Camera Controls (Unity Cinemachine) -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="🎥 3D Камера (Unity Cinemachine)" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10"/>
                    
                    <CheckBox Content="Следить за объектом"
                              IsChecked="{Binding CameraFollow, Mode=TwoWay}" Margin="0,0,0,10"/>

                    <CheckBox Content="🚀 Старт из космоса (Globe Intro)"
                              IsChecked="{Binding EnableSpaceIntro, Mode=TwoWay}" Margin="0,0,0,10"/>

                    <TextBlock Text="Режим ракурса камеры:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <UniformGrid Columns="3" Margin="0,0,0,12">
                        <Button Content="3D Погоня" Style="{StaticResource GhostBtn}" FontSize="10" Padding="4,4" Margin="2" Tag="follow" Click="CameraMode_Click"/>
                        <Button Content="2D Сверху" Style="{StaticResource GhostBtn}" FontSize="10" Padding="4,4" Margin="2" Tag="overview" Click="CameraMode_Click"/>
                        <Button Content="3D Изометрия" Style="{StaticResource GhostBtn}" FontSize="10" Padding="4,4" Margin="2" Tag="isometric" Click="CameraMode_Click"/>
                    </UniformGrid>

                    <!-- Pitch Slider -->
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="3D Угол наклона:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="11">
                            <Run Text="{Binding CameraPitch, StringFormat={}{0:F0}°, Mode=OneWay}"/>
                        </TextBlock>
                    </Grid>
                    <Slider Minimum="0" Maximum="85"
                            Value="{Binding CameraPitch, Mode=TwoWay}"
                            IsMoveToPointEnabled="True"
                            SmallChange="5" LargeChange="15" Margin="0,0,0,10"/>

                    <!-- Zoom / Altitude Slider -->
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="Высота / Масштаб (Zoom):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="11">
                            <Run Text="{Binding CameraZoom, StringFormat={}{0:F1}, Mode=OneWay}"/>
                        </TextBlock>
                    </Grid>
                    <Slider Minimum="3" Maximum="16"
                            Value="{Binding CameraZoom, Mode=TwoWay}"
                            IsMoveToPointEnabled="True"
                            SmallChange="0.5" LargeChange="2" Margin="0,0,0,10"/>

                    <!-- Angle / Azimuth Offset Slider -->
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="Смещение ракурса (Азимут):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="11">
                            <Run Text="{Binding CameraBearingOffset, StringFormat={}{0:F0}°, Mode=OneWay}"/>
                        </TextBlock>
                    </Grid>
                    <Slider Minimum="-180" Maximum="180"
                            Value="{Binding CameraBearingOffset, Mode=TwoWay}"
                            IsMoveToPointEnabled="True"
                            SmallChange="15" LargeChange="45"/>
                </StackPanel>
            </Border>

            <!-- Map Style Card -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="🗺 Стиль карты" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                    <UniformGrid Columns="2">
                        <Button Content="Темная 3D" Style="{StaticResource GhostBtn}" FontSize="11" Padding="4" Margin="2" Tag="dark" Click="MapStyle_Click"/>
                        <Button Content="Светлая" Style="{StaticResource GhostBtn}" FontSize="11" Padding="4" Margin="2" Tag="light" Click="MapStyle_Click"/>
                        <Button Content="Спутник" Style="{StaticResource GhostBtn}" FontSize="11" Padding="4" Margin="2" Tag="satellite" Click="MapStyle_Click"/>
                        <Button Content="Мультяшная" Style="{StaticResource GhostBtn}" FontSize="11" Padding="4" Margin="2" Tag="cartoon" Click="MapStyle_Click"/>
                        <Button Content="OSM Liberty" Style="{StaticResource GhostBtn}" FontSize="11" Padding="4" Margin="2" Tag="liberty" Click="MapStyle_Click"/>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Overlays Card -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="🎨 Оверлеи и 3D эффекты" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                    <CheckBox Content="Метки городов"
                              IsChecked="{Binding ShowCityLabels, Mode=TwoWay}"/>
                    <CheckBox Content="Флаги стран"
                              IsChecked="{Binding ShowCountryFlags, Mode=TwoWay}"/>
                    <CheckBox Content="Всплывающие города"
                              IsChecked="{Binding ShowCityPopups, Mode=TwoWay}"
                              Margin="0,0,0,4"/>
                    <CheckBox IsChecked="{Binding EnableSounds, Mode=TwoWay}"
                              Margin="0,8,0,4">
                        <TextBlock Text="Включить звуковые эффекты (SFX)" 
                                   Foreground="{StaticResource AccentBrush}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                    </CheckBox>

                    <StackPanel Visibility="{Binding ShowCityPopups, Converter={StaticResource BoolToVis}}" Margin="24,0,0,12">
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Размер шрифта:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="10">
                                <Run Text="{Binding CityPopupFontSize, StringFormat={}{0:F0}px, Mode=OneWay}"/>
                            </TextBlock>
                        </Grid>
                        <Slider Minimum="10" Maximum="40"
                                Value="{Binding CityPopupFontSize, Mode=TwoWay}"
                                IsMoveToPointEnabled="True"
                                SmallChange="1" LargeChange="5"
                                Margin="0,0,0,8"/>

                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Прозрачность текста:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="10">
                                <Run Text="{Binding CityPopupOpacity, StringFormat={}{0:P0}, Mode=OneWay}"/>
                            </TextBlock>
                        </Grid>
                        <Slider Minimum="0" Maximum="1"
                                Value="{Binding CityPopupOpacity, Mode=TwoWay}"
                                IsMoveToPointEnabled="True"
                                SmallChange="0.05" LargeChange="0.2"
                                Margin="0,0,0,4"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="Прозрачность облаков:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="11">
                            <Run Text="{Binding CloudOpacity, StringFormat={}{0:P0}, Mode=OneWay}"/>
                        </TextBlock>
                    </Grid>
                    <Slider Minimum="0" Maximum="1"
                            Value="{Binding CloudOpacity, Mode=TwoWay}"
                            IsMoveToPointEnabled="True"
                            SmallChange="0.05" LargeChange="0.2"
                            Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="🌧 Интенсивность дождя:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="11">
                            <Run Text="{Binding RainIntensity, StringFormat={}{0:P0}, Mode=OneWay}"/>
                        </TextBlock>
                    </Grid>
                    <Slider Minimum="0" Maximum="1"
                            Value="{Binding RainIntensity, Mode=TwoWay}"
                            IsMoveToPointEnabled="True"
                            SmallChange="0.05" LargeChange="0.2"
                            Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="❄ Интенсивность снега:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="11">
                            <Run Text="{Binding SnowIntensity, StringFormat={}{0:P0}, Mode=OneWay}"/>
                        </TextBlock>
                    </Grid>
                    <Slider Minimum="0" Maximum="1"
                            Value="{Binding SnowIntensity, Mode=TwoWay}"
                            IsMoveToPointEnabled="True"
                            SmallChange="0.05" LargeChange="0.2"
                            Margin="0,0,0,12"/>

                    <!-- Lightning controls -->
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="⚡ Количество молний:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="11">
                            <Run Text="{Binding LightningIntensity, StringFormat={}{0:P0}, Mode=OneWay}"/>
                        </TextBlock>
                    </Grid>
                    <Slider Minimum="0" Maximum="1"
                            Value="{Binding LightningIntensity, Mode=TwoWay}"
                            IsMoveToPointEnabled="True"
                            SmallChange="0.05" LargeChange="0.2"
                            Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="⚡ Скорость молний:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="11">
                            <Run Text="{Binding LightningSpeed, StringFormat={}{0:P0}, Mode=OneWay}"/>
                        </TextBlock>
                    </Grid>
                    <Slider Minimum="0" Maximum="1"
                            Value="{Binding LightningSpeed, Mode=TwoWay}"
                            IsMoveToPointEnabled="True"
                            SmallChange="0.05" LargeChange="0.2"/>
                </StackPanel>
            </Border>

            <!-- Route distance summary Card -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="📊 Параметры маршрута" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                    <Grid>
                        <TextBlock Text="Общая дистанция:" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding DistanceLabel}"
                                   HorizontalAlignment="Right"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontWeight="Bold"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
