<UserControl x:Class="AirAnimation.App.Views.MapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">

    <Grid Background="{StaticResource BgDeepBrush}">
        <!-- WebView2 hosting MapLibre -->
        <wv2:WebView2 x:Name="WebMap"
                      Source="about:blank"
                      DefaultBackgroundColor="Transparent"/>

        <!-- Map style switcher overlay -->
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="12,12,0,0" Orientation="Vertical">
            <Border Style="{StaticResource Card}" Padding="8">
                <StackPanel>
                    <TextBlock Text="Стиль карты" FontSize="10"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,0,0,6"/>
                    <UniformGrid Columns="2" Width="130">
                        <Button Content="🌑 Dark"     Tag="dark"       Style="{StaticResource GhostBtn}" FontSize="11" Click="StyleBtn_Click" Margin="2"/>
                        <Button Content="☀ Light"    Tag="streets"    Style="{StaticResource GhostBtn}" FontSize="11" Click="StyleBtn_Click" Margin="2"/>
                        <Button Content="🛰 Спутник" Tag="satellite"  Style="{StaticResource GhostBtn}" FontSize="11" Click="StyleBtn_Click" Margin="2"/>
                        <Button Content="🏔 Рельеф"  Tag="outdoors"   Style="{StaticResource GhostBtn}" FontSize="11" Click="StyleBtn_Click" Margin="2"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Coordinates tooltip -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,60,12"
                Style="{StaticResource Card}" Padding="8,5">
            <TextBlock x:Name="CoordLabel"
                       FontSize="11" FontFamily="{StaticResource MonoFont}"
                       Foreground="{StaticResource TextMutedBrush}"
                       Text="Нажмите на карту для добавления точки"/>
        </Border>
    </Grid>
</UserControl>
