<UserControl x:Class="AirAnimation.App.Views.RouteEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AirAnimation.App.ViewModels"
             Background="Transparent">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="МАРШРУТ" Style="{StaticResource SectionHeader}" Margin="0,0,0,2"/>
                    <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                        <Run Text="{Binding Waypoints.Count, Mode=OneWay}"/>
                        <Run Text=" точек ·"/>
                        <Run Text="{Binding TotalDistanceKm, StringFormat={}{0:F1} км, Mode=OneWay}"
                             Foreground="{StaticResource AccentBrush}"/>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Margin="0,0,6,0"
                             Visibility="{Binding IsRouting, Converter={StaticResource BoolToVis}}">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="{StaticResource Warning}"/>
                        </Ellipse.Fill>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0.2" Duration="0:0:0.5" AutoReverse="True"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <TextBlock Text="Маршрутизация..." FontSize="10"
                               Foreground="{StaticResource WarningBrush}"
                               Visibility="{Binding IsRouting, Converter={StaticResource BoolToVis}}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Separator Grid.Row="0" VerticalAlignment="Bottom" Margin="0"/>

        <!-- Route name -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12,8">
                <TextBlock Text="Название маршрута" FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding RouteName, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,8"/>

                <CheckBox Content="Режим полёта (по прямой)"
                          IsChecked="{Binding IsFlightMode}"
                          Margin="0,0,0,12"/>

                <TextBlock Text="ТОЧКИ" Style="{StaticResource SectionHeader}"/>
                <TextBlock Text="Нажмите на карту для добавления точек маршрута"
                           FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,8"
                           Visibility="{Binding Waypoints.Count, Converter={StaticResource ZeroCountToVis}}"/>

                <!-- Waypoints list -->
                <ItemsControl ItemsSource="{Binding Waypoints}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:WaypointItemViewModel}">
                            <Border Margin="0,2"
                                    CornerRadius="8"
                                    Background="{StaticResource BgCardBrush}"
                                    BorderBrush="{StaticResource BorderBrush_}"
                                    BorderThickness="1"
                                    Padding="10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding CoordText}"
                                                   FontSize="10" FontFamily="{StaticResource MonoFont}"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="↑" Style="{StaticResource GhostBtn}" FontSize="12" Padding="6,4"
                                                Command="{Binding DataContext.MoveWaypointUpCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="↓" Style="{StaticResource GhostBtn}" FontSize="12" Padding="6,4"
                                                Command="{Binding DataContext.MoveWaypointDownCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="✕" Style="{StaticResource DangerBtn}" FontSize="12" Padding="6,4"
                                                Command="{Binding DataContext.RemoveWaypointCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom hint -->
        <Border Grid.Row="2" Padding="12,10"
                Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderBrush_}"
                BorderThickness="0,1,0,0">
            <TextBlock Text="💡 Перетащите маркеры для точной настройки"
                       FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                       TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>
